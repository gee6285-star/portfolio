# 서버 포트
PORT=4000

# 프론트엔드 주소 (CORS 허용용 - 배포 시 실제 주소로 변경)
FRONTEND_ORIGIN=http://localhost:5500

# ------------------------------------------------------------
# 관리자 로그인 (frontend/admin.html 에서 사용)
# ------------------------------------------------------------
# 1) 아래 명령으로 원하는 비밀번호의 해시값을 만든다 (원문은 저장 안 됨)
#      cd backend && npm run hash-password -- <원하는 비밀번호>
# 2) 출력된 해시값을 그대로 복사해서 아래에 붙여넣는다
ADMIN_PASSWORD_HASH=

# 로그인 세션(JWT) 서명용 비밀 키 - 아무 문자열이나 길고 무작위로 채우기
JWT_SECRET=

# ------------------------------------------------------------
# DB 연결 정보 (아직 미확정 상태)
# DB 종류(MySQL/PostgreSQL/MongoDB 등)와 호스트가 정해지면
# 아래 값을 채우고 backend/.env 파일로 복사해서 사용합니다.
# ------------------------------------------------------------
# DB_HOST=
# DB_PORT=
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
